{"html": "<div class=\"card\">\n  <h2>❓ Quiz — Barème +1 / −0.5 / 0 (30 questions)</h2>\n  <p style=\"color:var(--muted);font-size:.85rem\">Sélectionnez une réponse par question, puis corrigez. Score officiel.</p>\n  <div id=\"quizContainer\"></div>\n  <div style=\"display:flex;gap:10px;margin-top:12px;flex-wrap:wrap\">\n    <button onclick=\"gradeQuiz()\" style=\"background:linear-gradient(135deg,var(--ok),#16a34a);color:#0a0f1e;border:none;padding:11px 18px;border-radius:9px;cursor:pointer;font-weight:700\">Corriger</button>\n    <button onclick=\"resetQuiz()\" style=\"background:var(--card2);color:var(--text);border:1px solid var(--border);padding:11px 18px;border-radius:9px;cursor:pointer;font-weight:600\">Réinitialiser</button>\n  </div>\n  <div class=\"result\" id=\"quizScore\"></div>\n</div>"}