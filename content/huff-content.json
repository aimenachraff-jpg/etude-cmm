{"html": "<div class=\"card\">\n  <h2>🌳 Calculateur de Huffman</h2>\n  <div class=\"calc\">\n    <div style=\"grid-column:1/-1\"><label>Symboles (séparés par ,)</label><input id=\"hSym\" type=\"text\" value=\"A,B,C,D\"></div>\n    <div style=\"grid-column:1/-1\"><label>Fréquences (séparées par ,)</label><input id=\"hFreq\" type=\"text\" value=\"3,1,1,3\"></div>\n  </div>\n  <button onclick=\"calcHuff()\">Calculer les codes</button>\n  <div class=\"result\" id=\"rHuff\"></div>\n</div>"}